# Copy this file to .env and fill in real values there.
# .env is gitignored -- never commit real secrets.

# =============================================================================
# report.py (SPEC.md §19) -- required unless noted.
# =============================================================================

# --- Mailbox identity / business rules ---
REPORT_MAILBOX=u.ruma@regencyelectricals.com
EMPLOYEE_ALIASES=                       # optional, comma-separated
INTERNAL_DOMAINS=regencyelectricals.com

REPORT_TIMEZONE=Asia/Kolkata

# --- Gmail (read-only) ---
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_MAX_MESSAGES=2000

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
AI_MAX_RETRIES=3
AI_BODY_MAX_CHARS=4000

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHUNK_CHARS=3800
TELEGRAM_MAX_RETRIES=3

# --- Database / logging / display ---
DATABASE_PATH=data/regency.db
LOG_PATH=logs/report.log
PENDING_DISPLAY_LIMIT=10
PRIORITY_DISPLAY_LIMIT=5
MAX_WINDOW_DAYS=92

# =============================================================================
# Legacy bot-era names (still read directly by app/gmail/sync.py,
# app/ai/claude.py, app/enquiry/status.py, and their tests -- see
# PHASE0_DECISIONS.md Q1). Each falls back from the SPEC name above when
# the SPEC name is unset; set here only if you are still running the
# bot (scripts/run_telegram_bot.py) separately from report.py.
# =============================================================================

CLAUDE_API_KEY=                         # falls back to ANTHROPIC_API_KEY's value
GOOGLE_CREDENTIALS_FILE=credentials.json  # falls back to GMAIL_CREDENTIALS_PATH's value
GOOGLE_TOKEN_FILE=token.json              # falls back to GMAIL_TOKEN_PATH's value
COMPANY_EMAIL_DOMAIN=                   # falls back to INTERNAL_DOMAINS's value

# --- WhatsApp Business Cloud API (kept per decision Q1; not used by
# report.py, and not currently read by the bot either) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
