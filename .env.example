# Copy this file to .env and fill in real values there.
# .env is gitignored -- never commit real secrets.

# --- Claude API (used from Phase 2 onward) ---
CLAUDE_API_KEY=

# --- WhatsApp Business Cloud API (the eventual founder-facing channel) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Telegram (prototyping the bot flow before WhatsApp business
# verification is in place -- see README) ---
TELEGRAM_BOT_TOKEN=

# --- Gmail OAuth ---
# Paths to the OAuth client secret (downloaded once from Google Cloud
# Console) and the cached user token. Defaults below assume both files
# live in the project root.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- Database ---
DATABASE_PATH=data/regency.db

# --- Business rules ---
# Email domain used to tell an employee message (from this domain)
# apart from a customer message (any other domain), e.g.
# regencyelectricals.com. Required for accurate status tracking --
# see README "Key design decisions".
COMPANY_EMAIL_DOMAIN=
